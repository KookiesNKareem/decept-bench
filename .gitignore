# data/hf_dataset/ is a build artifact (regenerable via `make hf-pack`).
# We commit only the README + croissant metadata so the dataset card and
# license are visible at-rest; the parquets themselves stay local.
data/hf_dataset/*
!data/hf_dataset/README.md
!data/hf_dataset/croissant.json

# Local pod / cache layouts
pip_target/
.cache/
.huggingface/

# Secrets — defensive (api keys, tokens, credentials)
*.key
*.pem
secrets.json
credentials.json
*_secret*
*_token*

